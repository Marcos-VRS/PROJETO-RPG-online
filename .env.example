# Copie este arquivo para .env e ajuste os valores antes de subir o stack.
# Em DEV (WSL2): preencha senhas reais e mantenha hosts como 127.0.0.1.
# Em PROD (GCP VM): preencha senhas fortes e mantenha hosts internos do compose.

# -------- Django --------
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=true
# Lista separada por vírgula
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,roll3d6rpg.com,www.roll3d6rpg.com
# Sobrescrita opcional de CORS / CSRF (defaults já cobrem dev local + domínio prod)
# DJANGO_CORS_ALLOWED_ORIGINS=
# DJANGO_CSRF_TRUSTED_ORIGINS=

# -------- Postgres --------
POSTGRES_DB=roll3d6_dev
POSTGRES_USER=roll3d6_dev
POSTGRES_PASSWORD=troque-aqui
# Quando rodando via docker compose, o web container resolve "postgres".
# Quando rodando Django fora do compose, use 127.0.0.1.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -------- Redis --------
REDIS_HOST=redis
REDIS_PORT=6379

# -------- MinIO (S3-compatível) --------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=troque-aqui-min-8-chars

# -------- Ollama --------
# Em WSL2 + Ollama no Windows host:
#   OLLAMA_URL=http://host.docker.internal:11434/api/generate
# Em VM GCP rodando Ollama nativo na mesma VM:
#   OLLAMA_URL=http://host.docker.internal:11434/api/generate (com extra_hosts no compose)
OLLAMA_URL=http://host.docker.internal:11434/api/generate

# -------- LiveKit (dev) --------
# Em dev usamos --dev (chaves default). Em prod, gerar via `livekit-server generate-keys`
# e montar config no container.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdev12
LIVEKIT_URL=ws://127.0.0.1:7880

# -------- Cloudflare Tunnel (apenas referência; cloudflared roda no host) --------
# CLOUDFLARE_TUNNEL_NAME=roll3d6-dev
# CLOUDFLARE_HOSTNAME=dev.roll3d6rpg.com
